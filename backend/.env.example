# Application
APP_NAME=CampusFind
APP_VERSION=1.0.0
DEBUG=true

# Database (SQLite for dev — swap for PostgreSQL in production)
DATABASE_URL=sqlite:///./campusfind.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/campusfind

# Auth
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# College Email Domain (configurable)
ALLOWED_EMAIL_DOMAIN=college.edu

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
